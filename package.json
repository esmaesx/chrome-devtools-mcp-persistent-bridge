{
  "name": "chrome-devtools-mcp-persistent-bridge",
  "version": "0.1.3",
  "private": true,
  "description": "Persistent Chrome DevTools MCP bridge for Windows and macOS with authenticated local transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-newb/chrome-devtools-mcp-persistent-bridge.git"
  },
  "bugs": "https://github.com/dev-newb/chrome-devtools-mcp-persistent-bridge/issues",
  "homepage": "https://github.com/dev-newb/chrome-devtools-mcp-persistent-bridge#readme",
  "keywords": [
    "chrome-devtools",
    "codex",
    "mcp",
    "windows"
  ],
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tests/run.ps1",
    "doctor": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "test:macos": "node tests/proxy-args.mjs && node --test tests/macos-smoke.mjs",
    "setup:macos": "node scripts/setup-macos.mjs",
    "test:installer": "node --test tests/macos-installer.test.mjs",
    "test:installer:windows": "node --test tests/windows-installer.test.mjs",
    "test:launchagent": "node tests/macos-launchagent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chrome-devtools-mcp": "1.7.0",
    "zod": "4.4.3"
  }
}
